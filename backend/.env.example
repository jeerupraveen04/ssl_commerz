# Server
PORT=8080
NODE_ENV=development

# SSLCOMMERZ credentials (sandbox defaults: testbox / qwerty)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWD=qwerty

# SSLCOMMERZ endpoints (swap to securepay.sslcommerz.com for live)
SSLCOMMERZ_INITIATE_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATE_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# Public URL of THIS backend (used to build success/fail/cancel + IPN callbacks).
# Local: http://localhost:8080 | Render: https://your-service.onrender.com
BACKEND_PUBLIC_URL=http://localhost:8080

# Frontend origin (where customers are redirected after payment)
FRONTEND_URL=http://localhost:3000

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
